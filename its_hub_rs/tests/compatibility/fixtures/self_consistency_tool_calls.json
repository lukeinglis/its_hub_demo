    "endpoint": "__MOCK__",
    "model": "test-model",
    "alg": "self-consistency",
    "tool_vote": "tool_name"
  },
  "request": {
    "model": "test-model",
    "messages": [
      {"role": "user", "content": "What's the weather in London?"}
    ],
    "budget": 5,
    "tools": [{"type": "function", "function": {"name": "get_weather", "parameters": {}}}]
  },
  "mock_responses": [
