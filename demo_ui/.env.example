# Environment variables for ITS demo
# Copy this file to .env and fill in your values
#
# Providers mirror Red Hat's model delivery paths (see backend/config.py):
#   maas        — models served by your infrastructure (default)
#   openrouter  — no-GPU fallback to the same validated open models
#   openai      — frontier models for "Match Frontier" comparisons

# ============================================================================
# OpenAI API (frontier models + LLM judge)
# ============================================================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# ============================================================================
# OpenRouter (no-GPU fallback to validated open models + Claude)
# ============================================================================
# Granite 4, gpt-oss, Llama 4, Qwen3, Claude Sonnet/Haiku.
# 1. Sign up at https://openrouter.ai/keys
# 2. Create an API key and paste it below:
# OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ============================================================================
# MaaS route (models served by your infrastructure — default provider)
# ============================================================================
# Point at an OpenShift AI MaaS route, a self-hosted vLLM server, or
# Red Hat AI Inference Server. MAAS_API_KEY is optional — unauthenticated
# routes work with a placeholder key.
# MAAS_BASE_URL=http://your-maas-route/v1
# MAAS_MODEL_NAME=ibm-granite/granite-4-h-small
# MAAS_CUSTOM_MODEL_NAME=your-model-name
# MAAS_API_KEY=your-token-if-required

# ============================================================================
# Judge / PRM (correctness judge, Best-of-N judge, process reward model)
# ============================================================================
# Defaults to your MaaS route + MaaS model when MAAS_BASE_URL is set — no
# OpenAI key needed. Falls back to gpt-5-mini via the OpenAI endpoint.
# Override explicitly with:
# JUDGE_BASE_URL=http://your-judge-endpoint/v1
# JUDGE_MODEL=ibm-granite/granite-4-h-small
# JUDGE_API_KEY=your-token-if-required

# ============================================================================
# Ollama (laptop quick-start — no GPU server needed)
# ============================================================================
# ollama pull granite4:3b && ollama serve
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ============================================================================
# Legacy vLLM var (still honored as fallback for MAAS_BASE_URL)
# ============================================================================
# VLLM_BASE_URL=http://localhost:8100/v1

# ============================================================================
# CORS Origins (Optional - comma-separated list of allowed origins)
# ============================================================================
# Override if serving from a different port or behind a reverse proxy.
# CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://lukeinglis.github.io
